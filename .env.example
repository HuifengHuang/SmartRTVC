# Development only. Must match deploy/livekit.yaml.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=local-development-secret-at-least-32-characters
LIVEKIT_URL=ws://localhost:7880
TOKEN_PORT=3001

# 第二阶段：推荐 node scripts/setup-stage2.mjs 自动生成 .env.stage2
# DB_PASSWORD=<random password>
# MYSQL_ROOT_PASSWORD=<different random password>
# JWT_SECRET=<at least 32 random characters>
# LIVEKIT_URL=http://127.0.0.1:7880
# LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
# APP_ORIGIN=http://127.0.0.1:5173
